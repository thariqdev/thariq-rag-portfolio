# Copy this file to .env.local and put your own keys after the = signs.
# .env.local is ignored by git. Never commit it, and never put a key in client code.

# Gemini: used for embeddings (searching the documents) and as the backup chat model.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq: used as the main chat model (it is fast).
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
